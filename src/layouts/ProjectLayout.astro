---
import "../styles/global.css";
import logoImg from "../assets/ChatGPT Image Jul 14, 2026, 02_03_10 PM(1).png";

interface Props {
  title: string;
  description?: string;
  /**
   * 'list'   — projects index: shows Home link + Projects active badge
   * 'detail' — project page:   shows Projects link only
   */
  pageType?: "list" | "detail";
}

const {
  title,
  description = "IT Architect specialising in Platform Engineering, DevOps and Cloud. Helping technical teams modernise complex systems through structured engineering and architectural clarity.",
  pageType = "list",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-c-16.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon-c.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
    <script is:inline>
      (function () {
        try {
          var theme = window.localStorage.getItem("cr-theme-v2");
          if (theme !== "dark" && theme !== "light") {
            theme =
              window.matchMedia &&
              window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          }
          if (theme === "dark") {
            document.documentElement.setAttribute("data-theme", "dark");
          }
          var lang = window.localStorage.getItem("cr-lang");
          if (lang === "es" || lang === "en") {
            document.documentElement.setAttribute("lang", lang);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="proj-skip" lang="en">Skip to content</a>
    <a href="#main" class="proj-skip" lang="es">Saltar al contenido</a>

    <header class="proj-header">
      <a
        href="/"
        class="proj-header__logo"
        aria-label="Celia Rico — back to home"
      >
        <span class="proj-header__logo-icon" aria-hidden="true">
          <img src={logoImg.src} alt="" class="proj-header__logo-img" />
        </span>
        <span class="proj-header__logo-text">
          <span class="proj-header__logo-name">Celia Rico</span>
          <span class="proj-header__logo-role" lang="en">IT Architect</span>
          <span class="proj-header__logo-role" lang="es">Arquitecta IT</span>
        </span>
      </a>

      <nav
        class="proj-header__nav"
        data-label-en={pageType === "list" ? "Primary" : "Primary"}
        data-label-es={pageType === "list" ? "Principal" : "Principal"}
        aria-label="Primary"
      >
        {
          pageType === "list" ? (
            <a href="/" class="proj-header__navlink">
              <span lang="en">Home</span>
              <span lang="es">Inicio</span>
            </a>
          ) : (
            <a href="/projects" class="proj-header__navlink">
              <span lang="en">Projects</span>
              <span lang="es">Proyectos</span>
            </a>
          )
        }

        {
          pageType === "list" && (
            <span class="proj-header__active" aria-current="page">
              <span class="proj-header__active-dot" aria-hidden="true" />
              <span lang="en">Projects</span>
              <span lang="es">Proyectos</span>
            </span>
          )
        }

        <span class="proj-header__divider" aria-hidden="true"></span>

        <div
          role="group"
          class="proj-lang-switch"
          data-lang-group
          data-label-en="Language selector"
          data-label-es="Selector de idioma"
        >
          <button
            type="button"
            class="proj-lang-switch__btn"
            data-lang-btn="en"
            aria-pressed="true"
          >
            EN
          </button>
          <button
            type="button"
            class="proj-lang-switch__btn"
            data-lang-btn="es"
            aria-pressed="false"
          >
            ES
          </button>
        </div>

        <button
          type="button"
          role="switch"
          aria-checked="false"
          class="proj-theme-toggle"
          data-theme-toggle
          data-label-en="Toggle dark mode"
          data-label-es="Cambiar modo oscuro/claro"
        >
          <span class="proj-theme-toggle__knob">
            <svg
              viewBox="0 0 16 16"
              class="proj-theme-toggle__icon proj-theme-toggle__icon--sun"
              aria-hidden="true"
            >
              <circle cx="8" cy="8" r="3.2"></circle>
              <line x1="8" y1="0.8" x2="8" y2="2.4"></line>
              <line x1="8" y1="13.6" x2="8" y2="15.2"></line>
              <line x1="0.8" y1="8" x2="2.4" y2="8"></line>
              <line x1="13.6" y1="8" x2="15.2" y2="8"></line>
              <line x1="2.9" y1="2.9" x2="4" y2="4"></line>
              <line x1="12" y1="12" x2="13.1" y2="13.1"></line>
              <line x1="2.9" y1="13.1" x2="4" y2="12"></line>
              <line x1="12" y1="4" x2="13.1" y2="2.9"></line>
            </svg>
            <svg
              viewBox="0 0 16 16"
              class="proj-theme-toggle__icon proj-theme-toggle__icon--moon"
              aria-hidden="true"
            >
              <circle cx="8" cy="8" r="5.4"></circle>
              <circle
                cx="10.6"
                cy="5.6"
                r="4.6"
                class="proj-theme-toggle__moon-mask"></circle>
            </svg>
          </span>
        </button>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="proj-footer">
      <div class="proj-footer__inner">
        <a href="/" class="proj-footer__logo">
          <span class="proj-footer__logo-icon" aria-hidden="true">
            <img src={logoImg.src} alt="" class="proj-footer__logo-img" />
          </span>
          <span class="proj-footer__logo-text">
            <span class="proj-footer__logo-name">Celia Rico</span>
            <span class="proj-footer__logo-role" lang="en">IT Architect</span>
            <span class="proj-footer__logo-role" lang="es">Arquitecta IT</span>
          </span>
        </a>
        <span class="proj-footer__copy">Celia Rico · 2026</span>
        {
          pageType === "list" ? (
            <a href="/" class="proj-footer__back">
              <span lang="en">Home ↑</span>
              <span lang="es">Inicio ↑</span>
            </a>
          ) : (
            <a href="/projects" class="proj-footer__back">
              <span lang="en">Projects ↑</span>
              <span lang="es">Proyectos ↑</span>
            </a>
          )
        }
      </div>
    </footer>
  </body>
</html>

<script>
  import { initInteractions } from "../scripts/interactions";
  document.addEventListener("DOMContentLoaded", () => initInteractions());
</script>

<style>
  .proj-skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 200;
    padding: 10px 16px;
    background: var(--ink);
    color: var(--bg);
    border-radius: 8px;
    font: 600 13px/1 var(--font-body);
    text-decoration: none;
    transition: top 0.2s;
  }

  .proj-skip:focus-visible {
    top: 12px;
  }

  /* ——— HEADER ——— */
  .proj-header {
    position: relative;
    z-index: 55;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px clamp(1.25rem, 4vw, 3.5rem);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    transition:
      background 0.4s,
      border-color 0.4s;
  }

  .proj-header__logo {
    display: flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
  }

  .proj-header__logo-icon {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: linear-gradient(150deg, var(--accent), var(--accent-2));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }

  .proj-header__logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .proj-header__logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .proj-header__logo-name {
    font: 700 15px/1 var(--font-body);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .proj-header__logo-role {
    font: 500 9px/1 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink3);
    margin-top: 4px;
  }

  .proj-header__nav {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2vw, 22px);
  }

  .proj-header__navlink {
    font: 500 13.5px/1 var(--font-body);
    color: var(--ink2);
    text-decoration: none;
    transition: color 0.25s;
  }

  .proj-header__navlink:hover {
    color: var(--ink);
  }

  .proj-header__active {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 15px;
    border-radius: 9px;
    border: 1px solid var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
    font: 600 13px/1 var(--font-body);
  }

  .proj-header__active-dot {
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--accent);
  }

  .proj-header__divider {
    width: 1px;
    height: 18px;
    background: var(--line);
  }

  /* Language switch */
  .proj-lang-switch {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 100px;
    background: var(--bg3);
    border: 1px solid var(--line);
  }

  .proj-lang-switch__btn {
    all: unset;
    cursor: pointer;
    padding: 5px 10px;
    border-radius: 100px;
    font: 600 11px/1 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--ink3);
    transition: all 0.25s;
  }

  html:not([lang="es"]) .proj-lang-switch__btn[data-lang-btn="en"],
  html[lang="es"] .proj-lang-switch__btn[data-lang-btn="es"] {
    background: var(--ink);
    color: var(--bg);
  }

  /* Theme toggle */
  .proj-theme-toggle {
    all: unset;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    width: 44px;
    height: 25px;
    border-radius: 100px;
    background: var(--line2);
    border: 1px solid var(--line);
    padding: 2px;
    transition: background 0.3s;
  }

  .proj-theme-toggle__knob {
    position: relative;
    width: 19px;
    height: 19px;
    border-radius: 50%;
    background: var(--bg2);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
    transform: translateX(0);
    transition: transform 0.3s cubic-bezier(0.16, 0.7, 0.3, 1);
  }

  html[data-theme="dark"] .proj-theme-toggle__knob {
    transform: translateX(19px);
  }

  .proj-theme-toggle__icon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.3s;
    stroke: var(--ink2);
    stroke-width: 1.3;
    stroke-linecap: round;
    fill: var(--ink2);
  }

  .proj-theme-toggle__icon--sun {
    opacity: 1;
  }

  .proj-theme-toggle__icon--moon {
    opacity: 0;
  }

  html[data-theme="dark"] .proj-theme-toggle__icon--sun {
    opacity: 0;
  }

  html[data-theme="dark"] .proj-theme-toggle__icon--moon {
    opacity: 1;
  }

  .proj-theme-toggle__moon-mask {
    fill: var(--bg2);
    stroke: none;
  }

  /* ——— FOOTER ——— */
  .proj-footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--line);
    padding: 32px clamp(1.25rem, 4vw, 3.5rem);
  }

  .proj-footer__inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .proj-footer__logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .proj-footer__logo-icon {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: linear-gradient(150deg, var(--accent), var(--accent-2));
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }

  .proj-footer__logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .proj-footer__logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .proj-footer__logo-name {
    font: 700 14px/1 var(--font-body);
    color: var(--ink);
  }

  .proj-footer__logo-role {
    font: 500 9px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink3);
    margin-top: 5px;
  }

  .proj-footer__copy {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink3);
  }

  .proj-footer__back {
    font: 600 12.5px/1 var(--font-body);
    color: var(--ink2);
    text-decoration: none;
    transition: color 0.3s;
  }

  .proj-footer__back:hover {
    color: var(--accent);
  }

  @media (max-width: 540px) {
    .proj-footer__inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 12px;
    }
  }

  @media (max-width: 640px) {
    .proj-header__active {
      display: none;
    }
  }
</style>
